# Wajib diisi — backend gak mau nyala tanpa ini
GROQ_API_KEY=

# Opsional
PORT=5000
VOICEVOX_API_URL=http://127.0.0.1:50021

# Opsional — path absolut ke folder prompt di vault Obsidian.
# Kosongkan/hapus baris ini kalau mau pakai bundel bawaan (backend/src/prompts/*.txt).
# Lihat obsidian-prompts/README.md di root project buat cara pasangnya.
PROMPTS_DIR=

# Opsional — kirim hasil final Agent Mode ke Telegram.
# Kosongkan berdua kalau gak butuh fitur ini, backend tetap jalan normal.
# TELEGRAM_BOT_TOKEN: dari @BotFather setelah bikin bot baru.
# TELEGRAM_CHAT_ID: chat tujuan (bisa DM ke bot-nya sendiri, ambil ID lewat @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
